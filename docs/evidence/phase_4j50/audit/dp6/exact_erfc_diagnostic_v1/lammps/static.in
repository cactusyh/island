# Four-layer convention identity 7eb83340b942e61a58240f6e52f21ae9c142010c1a49fc1927780bad719630c3
# Execution mode diagnostic; backend policy exact_erfc_diagnostic_v1
# Backend-only choices are not author authority. MD is blocked.
units real
atom_style full
boundary p p p
newton on
atom_modify sort 0 0
dielectric 1
bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style harmonic
pair_style lj/charmm/coul/long 9 11
pair_modify mix geometric shift no tail no table 0
special_bonds lj/coul 0 0 0.5
kspace_style ewald 0.0000001
kspace_modify gewald 0.35704189246991586 kmax/ewald 20 20 20
neighbor 2 bin
neigh_modify every 1 delay 0 check no
read_data system.data
include coefficients.in
compute virial all pressure NULL virial
thermo 1
thermo_style custom step ebond eangle edihed eimp evdwl ecoul elong pe c_virial[1] c_virial[2] c_virial[3] c_virial[4] c_virial[5] c_virial[6]
thermo_modify format float %.17g
run 0
write_dump all custom state.dump id type mol q x y z fx fy fz modify sort id format float %.17g
