units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
dihedral_style opls
pair_style lj/charmm/coul/long 9 11
pair_modify mix geometric
special_bonds lj/coul 0 0 0.5
kspace_style pppm 0.0001
read_data system.data
include coefficients.in
pair_modify table 0
kspace_style ewald 1e-7
kspace_modify gewald 0.35704189246991586 kmax/ewald 20 20 20
atom_modify sort 0 0
neigh_modify every 1 delay 0 check no
timestep 0.25
thermo 10
thermo_style custom step pe ke etotal temp
thermo_modify format float %.17g
min_style cg
minimize 1e-8 1e-8 100 1000
reset_timestep 0
