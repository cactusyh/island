include opls_system.in.init
read_data opls_system.data
include opls_system.in.settings
atom_modify sort 0 0.0
reset_timestep 0
timestep 0.5
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo 50
thermo_style custom step time atoms temp pe ke etotal ebond eangle edihed eimp evdwl ecoul elong density vol fmax
thermo_modify format float %.17g lost error
fix pilot all nvt temp 300.0 300.0 100.0
dump trajectory all custom 100 trajectory.lammpstrj id mol type q x y z ix iy iz vx vy vz
dump_modify trajectory sort id format float %.17g
restart 500 checkpoint.*.restart
run 1000
write_dump all custom final-state.lammpstrj id mol type q x y z ix iy iz vx vy vz fx fy fz modify sort id format float %.17g
write_restart final.restart
