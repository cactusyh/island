include opls_system.in.init
read_data opls_system.data
include opls_system.in.settings
kspace_style pppm 1e-9
kspace_modify order 7
pair_modify table 0
atom_modify sort 0 0.0
thermo 100
thermo_style custom step atoms temp pe ebond eangle edihed eimp evdwl ecoul elong etotal density vol
thermo_modify format float %.17g
run 0
print "REF 16229 $(fx[16229]:%.17g) $(fy[16229]:%.17g) $(fz[16229]:%.17g)" append fd-verified-records.tsv screen no
